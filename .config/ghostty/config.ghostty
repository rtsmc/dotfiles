gtk-single-instance = true
window-theme = dark
shell-integration = none

background = #181818
foreground = #E4E4E4

cursor-color = #E4E4E4
cursor-text = #181818

# Neovim Visual color
selection-background = #2D4F67
selection-foreground = cell-foreground

# Normal ANSI colors
palette = 0=#303041
palette = 1=#FF514A
palette = 2=#8AC071
palette = 3=#E6BB6D
palette = 4=#84ADFF
palette = 5=#B58BF4
palette = 6=#73B8AA
palette = 7=#E4E4E4

# Bright ANSI colors
palette = 8=#7F8097
palette = 9=#F25A60
palette = 10=#A8D86F
palette = 11=#FFD47A
palette = 12=#8AD0E8
palette = 13=#D4C7FF
palette = 14=#83D0C0
palette = 15=#F2F2F2



font-size = 10.5
adjust-font-baseline = 0
alpha-blending = linear-corrected
freetype-load-flags = hinting,autohint,light,no-force-autohint,no-monochrome
font-feature = -calt, -liga, -dlig
