#!/usr/bin/env bash

# my bookmarks file is formatted in such a way that it looks nice
# when rendered with markdown, so links are in the format [txt](link).
# This file parses that format and passes each bookmark to rofi
# for picking out and opening a bookmark.

bookmarks_file="$HOME/Documents/notes/bookmarks.md"

labels=()
urls=()

re_link='^\[([^]]+)\]\(([^)]+)\)$'

# Parse [text](url) lines into two arrays
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" =~ $re_link ]]; then
        labels+=("${BASH_REMATCH[1]}")
        urls+=("${BASH_REMATCH[2]}")
    fi
done < "$bookmarks_file"

# Build menu (1-based index for display)
menu=""
for i in "${!labels[@]}"; do
    menu+="$((i + 1)): ${labels[i]}"$'\n'
done

# Show menu in rofi; disable icons for speed
choice=$(printf '%s' "$menu" | dmenu -i -p "Bookmarks")
[[ -z "$choice" ]] && exit 0

index=${choice%%:*}
(( index-- ))

xdg-open "${urls[index]}" >/dev/null 2>&1
