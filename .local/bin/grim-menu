#!/bin/sh

# This is bound to Shift+mod+s by default, requires grim and slurp. It lets you
# choose the kind of screenshot to take, including copying the image or even
# highlighting an area to copy.

# variables
output="$(date '+%y%m%d-%H%M-%S').png"

case "$(printf "a selected area\\ncurrent window\\nfull screen\\na selected area (copy)\\ncurrent window (copy)\\nfull screen (copy)\\ncopy selected image to text" | bemenu -l 7 -i -p "Screenshot which area?")" in
    "a selected area") grim -g "$(slurp)" pic-selected-"${output}" ;;
    "full screen") grim pic-full-"${output}" ;;
    "a selected area (copy)") grim -g "$(slurp)" - | wl-copy ;;
    "full screen (copy)") grim - | wl-copy ;;
    "copy selected image to text") tmpfile=$(mktemp /tmp/ocr-XXXXXX.png) && grim -g "$(slurp)" "$tmpfile" && tesseract "$tmpfile" - -l eng | wl-copy && rm "$tmpfile" ;;
esac
