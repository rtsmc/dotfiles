#!/bin/sh

# A (rofi) dmenu wrapper script for system functions.
case $(rofi -dmenu -no-show-icons -i -p 'Action: ' << EOF
󰌾 lock
󰍃 logout
󰤄 sleep
 reboot
󰐥 shutdown
EOF
) in
    '󰌾 lock') swaylock;;
    '󰍃 logout') swaymsg exit ;;
    '󰤄 sleep') systemctl suspend ;;
    ' reboot') systemctl reboot ;;
    '󰐥 shutdown') systemctl poweroff ;;
    *) exit 1 ;;
esac
