#!/usr/bin/env bash

# adapted from https://github.com/ThePrimeagen/tmux-sessionizer

if [[ $# -eq 1 ]]; then
    selected=$1
else
    candidates=()
    for dir in "$HOME/projects" "$HOME/.config" "$HOME/Documents/notes/learning"; do
        [[ -d $dir ]] || continue
        while IFS= read -r path; do
            candidates+=("$path")
        done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d ! -name ".*")
    done

    for dir in "$HOME/.local/src" "$HOME/.local/bin"; do
        [[ -d $dir ]] && candidates+=("$dir")
    done

    selected=$(printf '%s\n' "${candidates[@]}" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux attach -t $selected_name
