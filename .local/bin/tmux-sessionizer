#!/usr/bin/env bash

# adapted from https://github.com/ThePrimeagen/tmux-sessionizer

if [[ $# -eq 1 ]]; then
    selected=$1
else
    find_output=$(find ~/projects ~/.config -mindepth 1 -maxdepth 1 -type d ! -name ".*")
    other_dirs="\n$HOME/.local/src"
    other_dirs="$other_dirs\n$HOME/.local/bin"
    other_dirs="$other_dirs\n$(ls -d $HOME/projects/cs304/Homework/*)"
    other_dirs="$other_dirs\n$(ls -d $HOME/projects/cs304/ClassMaterials/*)"
    other_dirs="$other_dirs\n$(ls -d $HOME/projects/cs304/Sample_Exams/*)"

    selected=$(printf "$find_output $other_dirs" | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux attach -t $selected_name
