# This repository uses $HOME as its work tree. Ignore everything by default,
# then allowlist the dotfiles that are intentionally public.
/*

!/.gitignore
!/README.md
!/.Xresources
!/.xinitrc
!/.zshenv

!/.config/
/.config/**
!/.config/alacritty/
!/.config/alacritty/alacritty.toml
!/.config/alacritty/edge-dark.toml
!/.config/dunst/
!/.config/dunst/dunstrc
!/.config/fontconfig/
!/.config/fontconfig/fonts.conf
!/.config/ghostty/
!/.config/ghostty/config.ghostty
!/.config/i3/
!/.config/i3/config
!/.config/i3status/
!/.config/i3status/config
!/.config/keyd/
!/.config/keyd/default.conf
!/.config/nvim/
!/.config/nvim/colors/
!/.config/nvim/colors/kanagawa.lua
!/.config/nvim/init.lua
!/.config/nvim/nvim-pack-lock.json
!/.config/rofi/
!/.config/rofi/config.rasi
!/.config/rofi/kanagawa.rasi
!/.config/sway/
!/.config/sway/config
!/.config/tmux/
!/.config/tmux/tmux.conf
!/.config/waybar/
!/.config/waybar/config.jsonc
!/.config/waybar/style.css
!/.config/zsh/
!/.config/zsh/.zprofile
!/.config/zsh/.zsh_plugins.txt
!/.config/zsh/.zshrc

!/.local/
/.local/**
!/.local/bin/
!/.local/bin/bookmarks
!/.local/bin/focus-or-run
!/.local/bin/grim-menu
!/.local/bin/maim-menu
!/.local/bin/sysact
!/.local/bin/tmux-sessionizer
!/.local/share/
/.local/share/*
!/.local/share/wallpaper.jpg
